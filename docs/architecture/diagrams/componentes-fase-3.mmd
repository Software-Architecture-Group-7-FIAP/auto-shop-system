config:
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 17px
    primaryTextColor: "#1f2937"
    lineColor: "#61758a"
    clusterBkg: "#eaf4fb"
    clusterBorder: "#adc1d2"
