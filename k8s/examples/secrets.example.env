# Copy this file to an ignored local file and replace every value.
# This file is documentation only and is never referenced by Kustomize.
# DATABASE_URL is generated from DB_NAME, DB_USER, and DB_PASSWORD by deploy.ps1.
DB_NAME=oficina
DB_USER=oficina
DB_PASSWORD=local-secret-change-me
SECRET_KEY=replace-with-at-least-32-random-characters
INVERTEXTO_API_TOKEN=local-development-token
SMTP_USER=
SMTP_PASSWORD=
