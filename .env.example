# Use localhost when running on the host; use db when running inside Docker Compose
POSTGRES_USER=oficina
POSTGRES_PASSWORD=replace-with-local-only-database-password
POSTGRES_DB=oficina
DATABASE_URL=postgresql://oficina:replace-with-local-only-database-password@localhost:5432/oficina
# Anything other than development/dev/local/test/testing is treated as
# production: cookies get the Secure flag and the production validations below
# become mandatory. Deny by default, so a typo cannot weaken the deployment.
APP_ENV=development
APP_VERSION=local
SECRET_KEY=replace-with-at-least-32-random-characters-not-this-value
# Optional in development (leave blank to derive isolated keys from SECRET_KEY).
# Set four different random values (32+ chars) in staging/production.
ACCESS_TOKEN_SECRET=
# Customer JWTs are verified against the Lambda's public JWKS endpoint.
# Keep issuer/audience in sync with the auth contract agreed by the team.
CUSTOMER_JWT_JWKS_URL=
CUSTOMER_JWT_ISSUER=
CUSTOMER_JWT_AUDIENCE=
CUSTOMER_JWT_CLOCK_SKEW_SECONDS=0
CUSTOMER_JWT_JWKS_TIMEOUT_SECONDS=2
CUSTOMER_JWT_JWKS_CACHE_SECONDS=300
SERVICE_ORDER_EVENT_BUS_NAME=
REFRESH_TOKEN_PEPPER=
BUDGET_APPROVAL_TOKEN_SECRET=
TRACKING_TOKEN_SECRET=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_EMAIL=admin@oficina.local
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Login throttling, per IP and per username, per process.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
LOGIN_RATE_LIMIT_MAX_BUCKETS=10000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_BUCKETS=10000
REDIS_URL=
BUDGET_APPROVAL_TOKEN_EXPIRE_HOURS=72
TRACKING_TOKEN_EXPIRE_DAYS=7
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@oficina.local
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_REQUIRE_TLS=false
APP_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-CSRF-Token,X-Request-ID,X-Correlation-ID,Accept
CORS_ALLOW_CREDENTIALS=true
SECURITY_HSTS_ENABLED=false
INVERTEXTO_API_TOKEN=
AUTO_CREATE_SCHEMA=false
SKIP_CPF_EXTERNAL_VALIDATION=true
IMAGE_TAG=local
