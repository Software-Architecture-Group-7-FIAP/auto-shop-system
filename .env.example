# Use localhost when running on the host; use db when running inside Docker Compose
POSTGRES_USER=oficina
POSTGRES_PASSWORD=__SET_LOCAL_PASSWORD__
POSTGRES_DB=oficina
DATABASE_URL=postgresql://oficina:__SET_LOCAL_PASSWORD__@localhost:5432/oficina
APP_ENV=development
SECRET_KEY=__GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS__
DEV_ADMIN_PASSWORD=
DEV_ADMIN_EMAIL=admin@oficina.local
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BUDGET_APPROVAL_TOKEN_EXPIRE_HOURS=72
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@oficina.local
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_REQUIRE_TLS=false
APP_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true
SECURITY_HSTS_ENABLED=false
INVERTEXTO_API_TOKEN=
AUTO_CREATE_SCHEMA=false
SKIP_CPF_EXTERNAL_VALIDATION=true
IMAGE_TAG=local
